generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id              Int             @id @default(autoincrement())
  name            String
  address         String?
  adminPinHash    String?
  // مفتاح استرجاع كلمة السر - يضبطه المبرمج عند تأسيس الشركة، ومالك
  // الشركة يقدر يغيّره لاحقاً من الإعدادات. يُستخدم فقط بنافذة "نسيت
  // كلمة السر" للتحقق قبل السماح بتعيين كلمة سر جديدة لأي مستخدم بالشركة.
  recoveryKeyHash String?
  createdAt       DateTime        @default(now())
  branches        Branch[]
  users           User[]
  employees       Employee[]
  projects        Project[]
  suppliers       Supplier[]
  officeExpenses  OfficeExpense[]
  notifications   Notification[]
}

model Branch {
  id        Int        @id @default(autoincrement())
  name      String
  location  String?
  companyId Int
  createdAt DateTime   @default(now())
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]
  projects  Project[]
  users     User[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  branchId  Int?
  companyId Int
  createdAt DateTime @default(now())
  branch    Branch?  @relation(fields: [branchId], references: [id])
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // مالك الشركة (أول من أسّسها) - له كل الصلاحيات دايماً ولا أحد يقدر يقيّده.
  // بقية المستخدمين تُفتح لهم كل الصلاحيات افتراضياً، والمالك يتحكم فيها لاحقاً.
  isOwner   Boolean @default(false)
  canAdd    Boolean @default(true)
  canEdit   Boolean @default(true)
  canDelete Boolean @default(true)

  @@index([companyId])
}

model Employee {
  id             Int             @id @default(autoincrement())
  name           String
  position       String
  salary         Float
  phone          String?
  branchId       Int
  companyId      Int
  createdAt      DateTime        @default(now())
  attendances    Attendance[]
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salaryPayments SalaryPayment[]

  @@index([companyId])
}

model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime
  status     String
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
}

model SalaryPayment {
  id         Int      @id @default(autoincrement())
  amount     Float
  date       DateTime @default(now())
  type       String   @default("أسبوعي")
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Project {
  id          Int          @id @default(autoincrement())
  name        String
  client      String
  budget      Float
  status      String       @default("قيد التنفيذ")
  isArchived  Boolean      @default(false)
  notes       String?
  branchId    Int
  companyId   Int
  createdAt   DateTime     @default(now())
  attachments Attachment[]
  expenses    Expense[]
  materials   Material[]
  payments    Payment[]
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([companyId])
}

model Task {
  id          Int     @id @default(autoincrement())
  description String
  percentage  Int
  isCompleted Boolean @default(false)
  projectId   Int
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  companyId Int
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Float
  date      DateTime @default(now())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float
  date        DateTime @default(now())
  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Material {
  id         Int       @id @default(autoincrement())
  name       String
  quantity   Float
  unit       String
  price      Float
  date       DateTime  @default(now())
  projectId  Int
  supplierId Int?
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
}

model Attachment {
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  fileType  String?
  projectId Int
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  companyId Int
  createdAt DateTime   @default(now())
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  materials Material[]

  @@index([companyId])
}

model OfficeExpense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float
  companyId   Int
  date        DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}
